# GitForge Configuration Example
# Legacy reference only; the current server binaries do not load this TOML.
# See docs/RUNBOOK.md and docs/DEPLOYMENT.md for actual runtime configuration.

# =============================================================================
# Server Configuration
# =============================================================================
[server]
host = "0.0.0.0"
port = 8080

# =============================================================================
# Database Configuration
# =============================================================================
[database]
# SQLite for MVP (single instance)
url = "sqlite:/data/gitforge.db"

# PostgreSQL for production (recommended)
# url = "postgres://gitforge:password@postgres:5432/gitforge"

# =============================================================================
# Authentication
# =============================================================================
[auth]
# The API service reads JWT_SECRET_FILE (preferred) or JWT_SECRET from its
# environment; this sample TOML is not loaded by the API process. Access-token
# lifetime is set by ACCESS_TTL_SECS in gitforge-api/src/auth.rs (currently
# seven days). Refresh credentials rotate and extend the session for 30 days.

# =============================================================================
# Git Server
# =============================================================================
[git_server]
ssh_port = 2222
http_port = 8082
git_root = "/git"

# =============================================================================
# CI/CD Configuration
# =============================================================================
[ci]
# Path to pipeline definitions
pipeline_path = "/data/pipelines"

# Default timeout for jobs (in seconds)
job_timeout = 3600

# =============================================================================
# Runner Configuration
# =============================================================================
[runner]
# URL of the scheduler service
scheduler_url = "http://scheduler:8081"

# Runner name (unique identifier)
name = "docker-runner-1"

# Runner type (docker, firecracker, bare-metal)
runner_type = "docker"

# Number of concurrent jobs
capacity = 4

# Heartbeat interval in seconds
heartbeat_interval_secs = 30

# Per-job lease heartbeat interval in seconds (issue #243): proves a running
# job is still driven so fencing waits for the job to go quiet.
job_heartbeat_interval_secs = 15

# Job fetch interval in seconds
fetch_interval_secs = 5

# =============================================================================
# Scheduler Configuration
# =============================================================================
[scheduler]
# Scheduler HTTP port
port = 8081

# Maximum jobs to assign per runner
max_jobs_per_runner = 10

# Fence grace in seconds (issue #243): how long a running job's liveness
# proof may be silent before the scheduler fences it (default 300).
fence_grace_secs = 300

# =============================================================================
# Storage Configuration
# =============================================================================
[storage]
# Artifact storage path
artifact_path = "/data/artifacts"

# Cache storage path
cache_path = "/data/cache"

# =============================================================================
# Logging
# =============================================================================
[logging]
level = "info"
format = "json"  # or "pretty" for development

# =============================================================================
# Metrics & Observability
# =============================================================================
[metrics]
# Enable Prometheus metrics endpoint
enabled = true
port = 9090
path = "/metrics"

# =============================================================================
# Security
# =============================================================================
[security]
# CORS allowed origins (comma-separated)
cors_allowed_origins = "http://localhost:3000"

# Rate limiting (requests per minute)
rate_limit_per_minute = 100

#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# Dark Factory pre-commit Hook Dispatcher
# Detects language of staged files and runs only relevant checks.
# Quality gates run first (always, language-agnostic).
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
cd "$REPO_ROOT"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Source common utilities
# shellcheck source=/dev/null
source "${SCRIPT_DIR}/lib/common.sh"
# shellcheck source=/dev/null
source "${SCRIPT_DIR}/lib/language-detect.sh"

HOOK_FAILED=0

# ─── Quality Gates (always run first) ──────────────────────────────────────
INFO "Running quality gates..."
if ! bash "${SCRIPT_DIR}/pre-commit.d/quality-gates.sh"; then
    HOOK_FAILED=1
fi

# ─── Language-Specific Hooks ───────────────────────────────────────────────
if detect_go; then
    INFO "Go project detected — running Go hooks..."
    if ! bash "${SCRIPT_DIR}/pre-commit.d/go-hooks.sh"; then
        HOOK_FAILED=1
    fi
fi

if detect_python; then
    INFO "Python project detected — running Python hooks..."
    if ! bash "${SCRIPT_DIR}/pre-commit.d/python-hooks.sh"; then
        HOOK_FAILED=1
    fi
fi

if detect_rust; then
    INFO "Rust project detected — running Rust hooks..."
    if ! bash "${SCRIPT_DIR}/pre-commit.d/rust-hooks.sh"; then
        HOOK_FAILED=1
    fi
fi

if detect_typescript; then
    INFO "TypeScript project detected — running TypeScript hooks..."
    if ! bash "${SCRIPT_DIR}/pre-commit.d/ts-hooks.sh"; then
        HOOK_FAILED=1
    fi
fi

# ─── Summary ────────────────────────────────────────────────────────────────
if [ "$HOOK_FAILED" -eq 1 ]; then
    ERROR "Pre-commit hooks failed. Fix the issues above before committing."
    exit 1
fi

INFO "All pre-commit checks passed"
exit 0

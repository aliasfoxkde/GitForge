#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# GitForge pre-commit hook
# Runs: cargo fmt --check + strict clippy when Rust sources are staged.
# (The full workspace test suite runs in pre-push; CI reruns everything.)
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

INFO() { echo -e "${GREEN}[pre-commit]${NC} $*"; }
WARN() { echo -e "${YELLOW}[pre-commit]${NC} $*"; }
ERROR() { echo -e "${RED}[pre-commit]${NC} $*"; }

# Rust gates only make sense when Rust sources (or the manifest) changed.
if ! git diff --cached --name-only --diff-filter=ACMR | grep -q '\.rs$\|Cargo\.toml$\|Cargo\.lock$'; then
    INFO "No Rust sources staged — skipping cargo gates"
    exit 0
fi

# ─── Format check ────────────────────────────────────────────────────────────
INFO "Checking formatting (cargo fmt --check)..."
if ! cargo fmt --all -- --check; then
    ERROR "cargo fmt --check failed — run: cargo fmt --all"
    exit 1
fi

# ─── Strict clippy ───────────────────────────────────────────────────────────
# gitforge-api/test-util gates the ci_routes/webhook_routes suites; enable it
# so they are linted here exactly as CI lints them (.github/workflows/rust-ci.yml).
INFO "Running clippy (workspace, all targets, -D warnings)..."
if ! cargo clippy --workspace --all-targets --features gitforge-api/test-util -- -D warnings; then
    ERROR "clippy failed — fix the warnings before committing"
    exit 1
fi

INFO "Pre-commit checks passed."

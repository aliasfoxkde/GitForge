#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# Dark Factory pre-push Hook Dispatcher
# Detects language of project and runs full language-specific pre-push checks.
# Runs after pre-commit, before push is accepted.
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
cd "$REPO_ROOT"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "${SCRIPT_DIR}/lib/common.sh"
# shellcheck source=/dev/null
source "${SCRIPT_DIR}/lib/language-detect.sh"

HOOK_FAILED=0

# ─── Complexity Gate (all languages) ───────────────────────────────────────
INFO "Checking complexity limits..."
MAX_FILE_LINES=500
MAX_FUNC_LINES=50
MAX_CYCLOMATIC=10

# Check for oversized files
LARGE_FILES=$(find . \
    \( -path "./.git" -o -path "./vendor" -o -path "./target" \
       -o -path "./node_modules" -o -path "./.github" \
       -o -path "./template-parts" \) -prune -o \
    \( -name "*.go" -o -name "*.py" -o -name "*.rs" -o -name "*.ts" \) \
    -type f -exec wc -l {} \; 2>/dev/null | \
    awk -v limit="$MAX_FILE_LINES" '$1 > limit { print $2 ": " $1 " lines (limit: " limit ")" }' | head -5 || true)

if [ -n "$LARGE_FILES" ]; then
    WARN "Oversized source files detected:"
    echo "$LARGE_FILES"
fi

# ─── Clean Branch Check ───────────────────────────────────────────────────
DIRTY=$(git status --porcelain 2>/dev/null || true)
if [ -n "$DIRTY" ]; then
    WARN "Uncommitted changes detected — push anyway? (hook passed)"
fi

# ─── Language-Specific Pre-push Hooks ────────────────────────────────────
if detect_go; then
    INFO "Go project — running Go pre-push hooks..."
    if ! bash "${SCRIPT_DIR}/pre-push.d/go-push.sh"; then
        HOOK_FAILED=1
    fi
fi

if detect_python; then
    INFO "Python project — running Python pre-push hooks..."
    if ! bash "${SCRIPT_DIR}/pre-push.d/python-push.sh"; then
        HOOK_FAILED=1
    fi
fi

if detect_rust; then
    INFO "Rust project — running Rust pre-push hooks..."
    if ! bash "${SCRIPT_DIR}/pre-push.d/rust-push.sh"; then
        HOOK_FAILED=1
    fi
fi

if detect_typescript; then
    INFO "TypeScript project — running TypeScript pre-push hooks..."
    if ! bash "${SCRIPT_DIR}/pre-push.d/ts-push.sh"; then
        HOOK_FAILED=1
    fi
fi

# ─── Summary ────────────────────────────────────────────────────────────────
if [ "$HOOK_FAILED" -eq 1 ]; then
    ERROR "Pre-push hooks failed. Fix issues before pushing."
    exit 1
fi

INFO "All pre-push checks passed"
exit 0

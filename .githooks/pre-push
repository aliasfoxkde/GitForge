#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# GitForge pre-push hook
# Runs the fast local gate before pushing — fmt, clippy, route-docs drift,
# Aegis changed-files scan, and a bounded smoke test. Catches ~80% of
# failures that would otherwise burn CI capacity on the fedora runner.
#
# The 2-thread bound mirrors the CI test job (.gitforge.yml): unbounded
# test parallelism on this host loses spawned-binary protocol tests to
# load races (the git_http_edges / ci_trigger_flow flake class), while
# the bound keeps the suite deterministic well inside CI timeouts.
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

INFO()  { echo -e "${GREEN}[pre-push]${NC} $*"; }
WARN()  { echo -e "${YELLOW}[pre-push]${NC} $*"; }
ERROR() { echo -e "${RED}[pre-push]${NC} $*"; }

INFO "Running fast local gate (fmt + clippy + route-docs + Aegis + smoke)..."
if ! bash "$REPO_ROOT/scripts/gitforge-quick-check.sh"; then
    ERROR "Quick-check failed — fix the errors above before pushing."
    ERROR "Run 'cargo fmt --all && cargo clippy --workspace --all-targets -- -D warnings' to fix locally."
    exit 1
fi

# Advisory branch/commit hygiene. Never blocks the push — it reports a
# dirty tree, a non-kebab branch name, or commits that miss the
# conventional-commit format this repo documents in CLAUDE.md.
#
# The commit range is the upstream tracking ref against HEAD. Git's own
# pre-push arguments ($1=remote ref, $2=local ref) name the same branch
# for an ordinary push, so `git log $1..$2` would compare a ref with
# itself and check nothing.
UPSTREAM="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
if [ -n "$UPSTREAM" ]; then
    bash "$REPO_ROOT/.githooks/pre-push.d/20-clean-branch" "$UPSTREAM" HEAD || true
fi

INFO "Pre-push checks passed — pushing..."

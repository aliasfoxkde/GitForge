#!/usr/bin/env bash
# Report GitForge user-systemd and HTTP health without mutating the host.
set -u -o pipefail

JSON=false
case "${1:-}" in
    "") ;;
    --json) JSON=true ;;
    -h|--help)
        printf 'Usage: %s [--json]\n' "$(basename "$0")"
        exit 0
        ;;
    *)
        printf 'unknown option: %s\n' "$1" >&2
        exit 2
        ;;
esac

units=(
    gitforge-scheduler.service
    gitforge-api.service
    gitforge-ci.service
    gitforge-git-server.service
    gitforge-runner.service
)
declare -A endpoints=(
    [gitforge-api.service]='http://127.0.0.1:42780/health'
    [gitforge-ci.service]='http://127.0.0.1:42781/health'
    [gitforge-git-server.service]='http://127.0.0.1:42782/health'
)

rows=()
overall=0
for unit in "${units[@]}"; do
    active="unknown"
    enabled="unknown"
    memory_max="unknown"
    cpu_quota="unknown"
    if command -v systemctl >/dev/null 2>&1; then
        active=$(systemctl --user is-active "$unit" 2>/dev/null) || active="${active:-inactive}"
        enabled=$(systemctl --user is-enabled "$unit" 2>/dev/null) || enabled="${enabled:-unknown}"
        memory_max=$(systemctl --user show "$unit" --value --property=MemoryMax 2>/dev/null) || memory_max="${memory_max:-unknown}"
        cpu_quota=$(systemctl --user show "$unit" --value --property=CPUQuotaPerSecUSec 2>/dev/null) || cpu_quota="${cpu_quota:-unknown}"
    fi

    http_status="not_applicable"
    if [[ -n "${endpoints[$unit]+x}" ]]; then
        if command -v curl >/dev/null 2>&1; then
            http_status=$(curl --silent --show-error --max-time 5 \
                --output /dev/null --write-out '%{http_code}' \
                "${endpoints[$unit]}" 2>/dev/null) || http_status="${http_status:-000}"
        else
            http_status="curl_missing"
        fi
    fi

    if [[ "$active" != active ]]; then
        overall=1
    fi
    case "$http_status" in
        not_applicable|2[0-9][0-9]) ;;
        *) overall=1 ;;
    esac

    rows+=("$unit|$active|$enabled|$memory_max|$cpu_quota|$http_status")
done

if [[ "$JSON" == true ]]; then
    python3 - "$overall" "${rows[@]}" <<'PY'
import json
import sys

overall, *rows = sys.argv[1:]
services = []
for row in rows:
    unit, active, enabled, memory_max, cpu_quota, http_status = row.split("|", 5)
    services.append({"unit": unit, "active": active, "enabled": enabled,
                     "memory_max": memory_max, "cpu_quota": cpu_quota,
                     "http_status": http_status})
print(json.dumps({"status": "healthy" if overall == "0" else "degraded", "services": services}))
PY
else
    printf '%-32s %-10s %-10s %-14s %-14s %s\n' SERVICE SYSTEMD ENABLED MEMORY_MAX CPU_QUOTA HTTP
    for row in "${rows[@]}"; do
        IFS='|' read -r unit active enabled memory_max cpu_quota http_status <<<"$row"
        printf '%-32s %-10s %-10s %-14s %-14s %s\n' \
            "$unit" "$active" "$enabled" "$memory_max" "$cpu_quota" "$http_status"
    done
    if ((overall == 0)); then
        printf 'overall: healthy\n'
    else
        printf 'overall: degraded\n'
    fi
fi

exit "$overall"

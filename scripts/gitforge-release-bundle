#!/usr/bin/env bash
set -euo pipefail

source_root="${1:-}"
bundle_root="${2:-}"
release_id="${3:-}"

if [[ -z "$source_root" || -z "$bundle_root" || -z "$release_id" ]]; then
  echo 'usage: gitforge-release-bundle <source-root> <bundle-root> <release-id>' >&2
  exit 64
fi

if [[ ! -d "$source_root" ]]; then
  printf 'release bundle: source root does not exist: %s\n' "$source_root" >&2
  exit 1
fi

if [[ ! "$release_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
  printf 'release bundle: invalid release id: %s\n' "$release_id" >&2
  exit 64
fi

"$(dirname "$0")/gitforge-release-preflight" "$source_root"

source_commit="${GITFORGE_SOURCE_COMMIT:-}"
if [[ -z "$source_commit" ]]; then
  source_commit=$(git -C "$source_root" rev-parse HEAD 2>/dev/null || true)
fi
if [[ ! "$source_commit" =~ ^[0-9a-f]{40}$ ]]; then
  printf 'release bundle: exact source commit is required (set GITFORGE_SOURCE_COMMIT or pass a git checkout)\n' >&2
  exit 1
fi

toolchain="${GITFORGE_TOOLCHAIN:-}"
if [[ -z "$toolchain" ]]; then
  toolchain=$(rustc --version 2>/dev/null || true)
fi
if [[ -z "$toolchain" ]]; then
  printf 'release bundle: build toolchain is required (set GITFORGE_TOOLCHAIN or install rustc)\n' >&2
  exit 1
fi

release_dir="$bundle_root/$release_id"
if [[ -e "$release_dir" ]]; then
  printf 'release bundle: refusing to overwrite existing release: %s\n' "$release_dir" >&2
  exit 1
fi

mkdir -p "$release_dir/bin" "$release_dir/scripts" "$release_dir/systemd/user"

for binary in api ci git-server runner; do
  install -m 0755 "$source_root/$binary" "$release_dir/bin/$binary"
done

install -m 0755 "$source_root/scripts/gitforge-status" "$release_dir/scripts/gitforge-status"

for unit in gitforge-ci.service.example gitforge-runner.service.example; do
  install -m 0644 "$(dirname "$0")/../systemd/user/$unit" "$release_dir/systemd/user/$unit"
done

for policy in gitforge-resource-limits.conf gitforge-ci-resource-limits.conf gitforge-runner-resource-limits.conf; do
  install -m 0644 "$(dirname "$0")/../systemd/user/$policy" "$release_dir/systemd/user/$policy"
done

build_timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
(
  cd "$release_dir"
  cat > RELEASE_METADATA.txt <<EOF
release_id=$release_id
source_commit=$source_commit
build_timestamp_utc=$build_timestamp
toolchain=$toolchain
EOF
  sha256sum RELEASE_METADATA.txt bin/* scripts/* systemd/user/* | sort > MANIFEST.sha256
  cat > READY <<EOF
release_id=$release_id
source_commit=$source_commit
manifest=MANIFEST.sha256
EOF
)

printf 'release bundle: assembled %s\n' "$release_dir"
printf 'release bundle: files=%s\n' "$(wc -l < "$release_dir/MANIFEST.sha256")"
printf 'release bundle: ready\n'

#!/usr/bin/env bash
set -euo pipefail

release_dir="${1:-}"
if [[ -z "$release_dir" ]]; then
  echo 'usage: gitforge-release-verify <release-directory>' >&2
  exit 64
fi

if [[ ! -d "$release_dir" ]]; then
  printf 'release verify: directory does not exist: %s\n' "$release_dir" >&2
  exit 1
fi

required=(api ci git-server runner)
for binary in "${required[@]}"; do
  if [[ ! -x "$release_dir/bin/$binary" ]]; then
    printf 'release verify: missing or non-executable binary: %s\n' "$binary" >&2
    exit 1
  fi
done

if [[ ! -s "$release_dir/MANIFEST.sha256" || ! -s "$release_dir/READY" || ! -s "$release_dir/RELEASE_METADATA.txt" ]]; then
  echo 'release verify: non-empty READY marker, metadata, and checksum manifest are required' >&2
  exit 1
fi

(
  cd "$release_dir"
  sha256sum --check MANIFEST.sha256
)

metadata_commit=$(sed -n 's/^source_commit=//p' "$release_dir/RELEASE_METADATA.txt")
metadata_release=$(sed -n 's/^release_id=//p' "$release_dir/RELEASE_METADATA.txt")
metadata_timestamp=$(sed -n 's/^build_timestamp_utc=//p' "$release_dir/RELEASE_METADATA.txt")
metadata_toolchain=$(sed -n 's/^toolchain=//p' "$release_dir/RELEASE_METADATA.txt")
ready_commit=$(sed -n 's/^source_commit=//p' "$release_dir/READY")
ready_release=$(sed -n 's/^release_id=//p' "$release_dir/READY")
if [[ ! "$metadata_commit" =~ ^[0-9a-f]{40}$ || "$metadata_commit" != "$ready_commit" ]]; then
  echo 'release verify: metadata and READY source commits are missing or inconsistent' >&2
  exit 1
fi
if [[ -z "$metadata_release" || "$metadata_release" != "$ready_release" || -z "$metadata_timestamp" || -z "$metadata_toolchain" ]]; then
  echo 'release verify: release metadata is incomplete or inconsistent' >&2
  exit 1
fi

ci_unit="$release_dir/systemd/user/gitforge-ci.service.example"
runner_unit="$release_dir/systemd/user/gitforge-runner.service.example"
generic_policy="$release_dir/systemd/user/gitforge-resource-limits.conf"
ci_policy="$release_dir/systemd/user/gitforge-ci-resource-limits.conf"
runner_policy="$release_dir/systemd/user/gitforge-runner-resource-limits.conf"
for unit in "$ci_unit" "$runner_unit"; do
  if [[ ! -f "$unit" ]]; then
    printf 'release verify: missing unit example: %s\n' "$unit" >&2
    exit 1
  fi
done

for policy in "$generic_policy" "$ci_policy" "$runner_policy"; do
  if [[ ! -f "$policy" ]]; then
    printf 'release verify: missing resource policy: %s\n' "$policy" >&2
    exit 1
  fi
done

grep -Fq 'ExecStart=%h/work/gitforge-current/bin/ci' "$ci_unit"
grep -Fq 'Environment=SCHEDULER_PORT=42781' "$ci_unit"
grep -Fq 'Requires=gitforge-ci.service' "$runner_unit"
grep -Fq 'ExecStart=%h/work/gitforge-current/bin/runner' "$runner_unit"
grep -Fq 'Environment=GITFORGE_SCHEDULER_URL=http://127.0.0.1:42781' "$runner_unit"
if grep -Fq 'gitforge-scheduler.service' "$runner_unit"; then
  echo 'release verify: runner still depends on legacy standalone scheduler' >&2
  exit 1
fi

printf 'release verify: valid bundle=%s source=%s binaries=%d scheduler-owner=ci\n' \
  "$release_dir" "$metadata_commit" "${#required[@]}"

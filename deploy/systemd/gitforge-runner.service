[Unit]
Description=GitForge Runner
After=network-online.target podman.socket gitforge-scheduler.service
Wants=network-online.target
Requires=gitforge-scheduler.service

[Service]
Type=simple
WorkingDirectory=%h/Work/gitforge-delta-doctest
EnvironmentFile=-%h/.config/gitforge/gitforge.env
Environment=DOCKER_HOST=unix:///run/user/%U/podman/podman.sock
ExecStart=%h/Work/gitforge-delta-doctest/target/release/runner
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/gitforge

[Install]
WantedBy=default.target

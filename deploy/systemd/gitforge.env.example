# Copy to ~/.config/gitforge/gitforge.env and chmod 600.
# This file contains deployment settings only; never commit real credentials.
PORT=8081
SCHEDULER_URL=http://127.0.0.1:8081
RUNNER_NAME=remote-podman-runner
RUNNER_TYPE=docker
RUNNER_CAPACITY=1
RUNNER_HEARTBEAT_INTERVAL_SECS=30
RUNNER_FETCH_INTERVAL_SECS=5

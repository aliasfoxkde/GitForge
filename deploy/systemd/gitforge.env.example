# Copy to ~/.config/gitforge/gitforge.env and chmod 600.
# This file contains deployment settings only; never commit real credentials.
PORT=8081
SCHEDULER_BIND=127.0.0.1
SCHEDULER_URL=http://127.0.0.1:8081
# SCHEDULER_SHARED_SECRET=  # Optional: set to enable bearer-token auth on scheduler routes
RUNNER_NAME=remote-podman-runner
RUNNER_TYPE=docker
RUNNER_CAPACITY=1
RUNNER_HEARTBEAT_INTERVAL_SECS=30
RUNNER_FETCH_INTERVAL_SECS=5
# Persistent user-owned storage; do not fall back to /tmp for job logs/artifacts.
GITFORGE_ARTIFACT_ROOT=/home/mkinney/.local/share/gitforge/artifacts

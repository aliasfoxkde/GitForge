#!/bin/bash
# Atheon-Enhanced Pre-commit Hook
# Scans staged files for secrets and PII before commit
#
# Install: Copy this file to .git/hooks/pre-commit and make it executable
# Or run: ./hooks/install-atheon-hook.sh

set -e

# Configuration
ATHEON_BIN="${ATHEON_BINARY:-atheon}"
CATEGORIES="${ATHEON_CATEGORIES:-secrets,pii}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Atheon Security Scan${NC}"

# Check if atheon is installed
if ! command -v "$ATHEON_BIN" &> /dev/null; then
    echo -e "${YELLOW}Warning: atheon not found in PATH${NC}"
    echo "Install from: https://github.com/aliasfoxkde/Atheon-Enhanced"
    echo "Or download from releases: https://github.com/aliasfoxkde/Atheon-Enhanced/releases"
    echo "Skipping security scan..."
    exit 0
fi

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Filter to text files that should be scanned
SCAN_FILES=""
for f in $STAGED_FILES; do
    # Skip binary files and generated files
    if [[ "$f" == *.png || "$f" == *.jpg || "$f" == *.gif || "$f" == *.ico ]]; then
        continue
    fi
    # Skip node_modules, vendor, etc.
    if [[ "$f" == node_modules/* || "$f" == vendor/* || "$f" == target/* ]]; then
        continue
    fi
    SCAN_FILES="$SCAN_FILES $f"
done

if [ -z "$SCAN_FILES" ]; then
    echo -e "${GREEN}No files to scan${NC}"
    exit 0
fi

echo "Scanning staged files for secrets and PII..."

# Run atheon scan
SCAN_OUTPUT=$("$ATHEON_BIN" --categories="$CATEGORIES" $SCAN_FILES 2>&1) || true

if [ -n "$SCAN_OUTPUT" ]; then
    echo -e "${RED}⚠️  Security issues detected:${NC}"
    echo "$SCAN_OUTPUT"
    echo ""
    echo -e "${RED}Commit blocked: secrets or PII detected in staged files${NC}"
    echo ""
    echo "To proceed without scanning, use: git commit --no-verify"
    echo "To scan all files and bypass, use: git commit --no-verify"
    exit 1
fi

echo -e "${GREEN}✓ No secrets or PII detected in staged files${NC}"
exit 0

# GitForge Environment Configuration
# Copy to .env.local and customize

# =============================================================================
# API Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=42780

# REQUIRED: Set a strong secret key (minimum 32 characters)
# NEVER use the default value in production!
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_IN_PRODUCTION

DATABASE_URL=sqlite:///nas/Temp/repos/GitForge/data/gitforge.db?mode=rwc

# =============================================================================
# Git Server Configuration
# =============================================================================
GIT_ROOT=/nas/Temp/repos/GitForge/repos
SSH_PORT=42022
HTTP_PORT=42782

# =============================================================================
# CI Configuration
# =============================================================================
CI_ENABLED=true
RUST_LOG=info

# =============================================================================
# Runner Configuration
# =============================================================================
GITFORGE_RUNNER_NAME=docker-runner-1
GITFORGE_RUNNER_CAPACITY=4
GITFORGE_SCHEDULER_URL=http://localhost:42781
GITFORGE_HEARTBEAT_INTERVAL=30
GITFORGE_FETCH_INTERVAL=5

# Shared scheduler API credential. Required in compose deployments: the
# scheduler refuses runner/operator requests when it is unset, and runners
# cannot register without it. Generate with: openssl rand -hex 32
GITFORGE_SCHEDULER_TOKEN=
# Registration-failure policy: deny (default) exits the runner when the
# scheduler is unreachable; allow falls back to standalone execution.
GITFORGE_RUNNER_STANDALONE=deny

# =============================================================================
# Docker Compose Deployment
# =============================================================================
# REQUIRED for `docker compose up`: host group id that owns
# /var/run/docker.sock so the non-root runner can use the mounted socket.
# Find yours with: stat -c %g /var/run/docker.sock
DOCKER_GID=
# REQUIRED for `docker compose up`: host directory where CI checks out run
# workspaces. It is bind-mounted at the same absolute path in the ci and
# runner containers because the runner passes workspace paths to the host
# Docker daemon as bind sources. Create it first: mkdir -p <dir>
GITFORGE_WORKSPACE_HOST_DIR=

# =============================================================================
# Paths
# =============================================================================
ARTIFACT_PATH=/nas/Temp/repos/GitForge/artifacts
CACHE_PATH=/nas/Temp/repos/GitForge/cache
